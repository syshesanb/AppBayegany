<Window x:Class="BayeganyApp.Windows.ManageSubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت ساختار درختی و سلسله‌مراتبی موضوعات (سه‌سطحی)" 
        Height="780" Width="1220"
        MinHeight="640" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F1F5F9">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- ۱. هدر و نوار عنوان -->
            <RowDefinition Height="*"/>    <!-- ۲. سه ستون سلسله‌مراتبی موضوعات -->
            <RowDefinition Height="Auto"/> <!-- ۳. نوار مسیر انتخاب‌شده (Breadcrumb) -->
            <RowDefinition Height="Auto"/> <!-- ۴. نوار دکمه‌های پایین -->
        </Grid.RowDefinitions>

        <!-- ۱. هدر اصلی پنجره -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📁 ساختار درختی و دسته‌بندی موضوعات اسناد (سه‌سطحی)" Foreground="White" FontSize="15.5" FontWeight="Bold"/>
                    <TextBlock Text="امکان انتخاب، ویرایش نام، حذف و ثبت موضوعات اصلی، فرعی ۱ و فرعی ۲" Foreground="#93C5FD" FontSize="11.5" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E40AF" CornerRadius="4" Padding="10,4">
                    <TextBlock Text="سامانه بایگانی هوشمند" Foreground="#E0E7FF" FontSize="11.5"/>
                </Border>
            </Grid>
        </Border>

        <!-- ۲. بدنه اصلی در سه ستون منظم -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ستون ۱: موضوعات اصلی -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- عنوان ستون -->
                        <RowDefinition Height="Auto"/> <!-- فرم ثبت/ویرایش -->
                        <RowDefinition Height="*"/>    <!-- لیست موضوعات -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="۱. موضوعات اصلی 📁" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13.5"/>
                        <TextBlock Grid.Column="1" x:Name="TxtMainCount" Text="(۰ مورد)" Foreground="#64748B" FontSize="11.5"/>
                    </Grid>

                    <!-- فرم ثبت و ویرایش موضوع اصلی -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtNewMainSubject" Height="34" ToolTip="عنوان موضوع اصلی را وارد کنید"/>
                        <Button Grid.Column="1" x:Name="BtnSaveMain" Content="➕ ثبت" Click="BtnSaveMain_Click" Width="70" Height="34" Margin="4,0,0,0" Background="#16A34A" FontWeight="Bold"/>
                        <Button Grid.Column="2" x:Name="BtnCancelMainEdit" Content="❌" Click="BtnCancelMainEdit_Click" Width="34" Height="34" Margin="4,0,0,0" Background="#64748B" ToolTip="انصراف از ویرایش" Visibility="Collapsed"/>
                    </Grid>

                    <!-- لیست موضوعات اصلی با دکمه‌های عملیات -->
                    <ListBox Grid.Row="2" x:Name="ListMainSubjects" SelectionChanged="ListMainSubjects_SelectionChanged" BorderBrush="#E2E8F0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,5" Margin="0,1" CornerRadius="4" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📁 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                        
                                        <!-- دکمه‌های عملیاتی سطری: انتخاب، ویرایش، حذف -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Click="BtnSelectMain_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#10B981" Foreground="White" 
                                                    ToolTip="انتخاب این موضوع اصلی">
                                                <TextBlock Text="✔️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Click="BtnEditMain_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#0284C7" Foreground="White" 
                                                    ToolTip="ویرایش نام موضوع">
                                                <TextBlock Text="✏️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Click="BtnDeleteMain_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#DC2626" Foreground="White" 
                                                    ToolTip="حذف این موضوع و زیرمجموعه‌های آن">
                                                <TextBlock Text="🗑️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ستون ۲: موضوعات فرعی ۱ -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- عنوان ستون -->
                        <RowDefinition Height="Auto"/> <!-- فرم ثبت/ویرایش -->
                        <RowDefinition Height="*"/>    <!-- لیست موضوعات -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSub1Header" Text="۲. موضوعات فرعی ۱ (زیرشاخه) 📂" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="TxtSub1Count" Text="(۰ مورد)" Foreground="#64748B" FontSize="11.5"/>
                    </Grid>

                    <!-- فرم ثبت و ویرایش موضوع فرعی ۱ -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtNewSubSubject1" Height="34" IsEnabled="False" ToolTip="عنوان موضوع فرعی ۱ را وارد کنید"/>
                        <Button Grid.Column="1" x:Name="BtnSaveSub1" Content="➕ ثبت" Click="BtnSaveSub1_Click" Width="70" Height="34" Margin="4,0,0,0" Background="#16A34A" FontWeight="Bold" IsEnabled="False"/>
                        <Button Grid.Column="2" x:Name="BtnCancelSub1Edit" Content="❌" Click="BtnCancelSub1Edit_Click" Width="34" Height="34" Margin="4,0,0,0" Background="#64748B" ToolTip="انصراف از ویرایش" Visibility="Collapsed"/>
                    </Grid>

                    <!-- لیست موضوعات فرعی ۱ با دکمه‌های عملیات -->
                    <ListBox Grid.Row="2" x:Name="ListSubSubjects1" SelectionChanged="ListSubSubjects1_SelectionChanged" BorderBrush="#E2E8F0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,5" Margin="0,1" CornerRadius="4" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📂 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                        
                                        <!-- دکمه‌های عملیاتی سطری: انتخاب، ویرایش، حذف -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Click="BtnSelectSub1_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#10B981" Foreground="White" 
                                                    ToolTip="انتخاب این موضوع فرعی ۱">
                                                <TextBlock Text="✔️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Click="BtnEditSub1_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#0284C7" Foreground="White" 
                                                    ToolTip="ویرایش نام موضوع">
                                                <TextBlock Text="✏️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Click="BtnDeleteSub1_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#DC2626" Foreground="White" 
                                                    ToolTip="حذف این موضوع و ریزموضوعات آن">
                                                <TextBlock Text="🗑️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ستون ۳: موضوعات فرعی ۲ -->
            <Border Grid.Column="4" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- عنوان ستون -->
                        <RowDefinition Height="Auto"/> <!-- فرم ثبت/ویرایش -->
                        <RowDefinition Height="*"/>    <!-- لیست موضوعات -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSub2Header" Text="۳. موضوعات فرعی ۲ (ریزموضوع) 📄" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="TxtSub2Count" Text="(۰ مورد)" Foreground="#64748B" FontSize="11.5"/>
                    </Grid>

                    <!-- فرم ثبت و ویرایش موضوع فرعی ۲ -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtNewSubSubject2" Height="34" IsEnabled="False" ToolTip="عنوان موضوع فرعی ۲ را وارد کنید"/>
                        <Button Grid.Column="1" x:Name="BtnSaveSub2" Content="➕ ثبت" Click="BtnSaveSub2_Click" Width="70" Height="34" Margin="4,0,0,0" Background="#16A34A" FontWeight="Bold" IsEnabled="False"/>
                        <Button Grid.Column="2" x:Name="BtnCancelSub2Edit" Content="❌" Click="BtnCancelSub2Edit_Click" Width="34" Height="34" Margin="4,0,0,0" Background="#64748B" ToolTip="انصراف از ویرایش" Visibility="Collapsed"/>
                    </Grid>

                    <!-- لیست موضوعات فرعی ۲ با دکمه‌های عملیات -->
                    <ListBox Grid.Row="2" x:Name="ListSubSubjects2" SelectionChanged="ListSubSubjects2_SelectionChanged" BorderBrush="#E2E8F0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,5" Margin="0,1" CornerRadius="4" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📄 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                        
                                        <!-- دکمه‌های عملیاتی سطری: انتخاب، ویرایش، حذف -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Click="BtnSelectSub2_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#10B981" Foreground="White" 
                                                    ToolTip="انتخاب این موضوع فرعی ۲">
                                                <TextBlock Text="✔️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Click="BtnEditSub2_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#0284C7" Foreground="White" 
                                                    ToolTip="ویرایش نام موضوع">
                                                <TextBlock Text="✏️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Click="BtnDeleteSub2_Click" Tag="{Binding}" 
                                                    Width="28" Height="26" Margin="2,0" 
                                                    Background="#DC2626" Foreground="White" 
                                                    ToolTip="حذف این موضوع">
                                                <TextBlock Text="🗑️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ۳. نوار مسیر انتخاب‌شده سلسله‌مراتبی (Breadcrumb) -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📍 مسیر موضوعی جاری:" FontWeight="Bold" Foreground="#1E3A8A" FontSize="12.5" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="TxtSelectedHierarchy" Text="(هیچ موضوعی انتخاب نشده است)" Foreground="#047857" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- ۴. فوتر پنجره -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="بستن پنجره" Click="BtnClose_Click" Width="110" Height="34" Background="#64748B"/>
                <Button Grid.Column="2" x:Name="BtnConfirmSelection" Content="✔️ تایید و انتخاب این موضوع" Click="BtnConfirmSelection_Click" Width="200" Height="34" Background="#16A34A" FontWeight="Bold" IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
