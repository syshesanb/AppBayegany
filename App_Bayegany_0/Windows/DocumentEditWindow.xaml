<Window x:Class="BayeganyApp.Windows.DocumentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BayeganyApp.Controls"
        Title="ثبت و ویرایش سند و متادیتا" 
        Height="820" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- هدر پنجره -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <TextBlock x:Name="TxtWindowTitle" Text="➕ ثبت سند و پرونده جدید در بایگانی" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </Border>

        <!-- بدنه دو ستونه (فرم متادیتا در راست | نمایشگر تصاویر و OCR در چپ) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/> <!-- فرم متادیتا -->
                <ColumnDefinition Width="8"/>   <!-- اسپلیتر -->
                <ColumnDefinition Width="*"/>   <!-- پیش‌نمایش تصویر و OCR -->
            </Grid.ColumnDefinitions>

            <!-- ستون راست: فرم ثبت اطلاعات -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ۱. کد بایگانی (اجباری و کلیدی) -->
                        <TextBlock Text="🏷️ کد بایگانی / پرونده (CodBayegany) *" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCodBayegany" Height="34" Margin="0,0,0,10" ToolTip="کد زونکن، شماره پوشه یا شناسه فیزیکی سند"/>

                        <!-- ۲. شماره و تاریخ سند -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="شماره مدرک / نامه" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDocNumber" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تاریخ صدور سند *" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDocDate" Height="34"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="📆" Click="BtnPickDocDate_Click" Width="34" Height="34" VerticalAlignment="Bottom" Margin="4,0,0,0" Background="#E2E8F0" Foreground="#1E293B"/>
                        </Grid>

                        <!-- ۳. نوع مدرک و برچسب رنگی -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نوع مدرک" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbDocType" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="برچسب وضعیت" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbColorTag" Height="34"/>
                            </StackPanel>
                        </Grid>

                        <!-- ۴. موضوعات سلسله‌مراتبی (سه‌سطحی) -->
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="10" Margin="0,4,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📁 دسته‌بندی موضوعی (سلسله‌مراتبی)" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8"/>

                                <!-- موضوع اصلی -->
                                <TextBlock Text="موضوع اصلی *" FontSize="12" Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="CmbMainSubject" SelectionChanged="CmbMainSubject_SelectionChanged" Height="32"/>
                                    <Button Grid.Column="1" Content="➕" Click="BtnAddMainSubject_Click" Width="32" Height="32" Margin="4,0,0,0" Background="#16A34A" ToolTip="تعریف موضوع اصلی جدید"/>
                                </Grid>

                                <!-- موضوع فرعی ۱ -->
                                <TextBlock Text="موضوع فرعی ۱ (پروژه / بخش)" FontSize="12" Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="CmbSubSubject1" SelectionChanged="CmbSubSubject1_SelectionChanged" Height="32" IsEnabled="False"/>
                                    <Button Grid.Column="1" Content="➕" Click="BtnAddSubSubject1_Click" Width="32" Height="32" Margin="4,0,0,0" Background="#16A34A" ToolTip="تعریف موضوع فرعی ۱ جدید"/>
                                </Grid>

                                <!-- موضوع فرعی ۲ -->
                                <TextBlock Text="موضوع فرعی ۲ (فاز / ریزموضوع)" FontSize="12" Margin="0,0,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="CmbSubSubject2" Height="32" IsEnabled="False"/>
                                    <Button Grid.Column="1" Content="➕" Click="BtnAddSubSubject2_Click" Width="32" Height="32" Margin="4,0,0,0" Background="#16A34A" ToolTip="تعریف موضوع فرعی ۲ جدید"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ۵. اشخاص مرتبط سه‌گانه -->
                        <Border Background="#F0FDF4" CornerRadius="4" Padding="10" Margin="0,0,0,12" BorderBrush="#DCFCE7" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="👥 اشخاص مرتبط با سند" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,8"/>

                                <!-- شخص اصلی -->
                                <TextBlock Text="طرف / شخص اصلی *" FontSize="12" Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="CmbMainPerson" Height="32"/>
                                    <Button Grid.Column="1" Content="➕" Click="BtnAddPerson_Click" Width="32" Height="32" Margin="4,0,0,0" Background="#16A34A" ToolTip="تعریف شخص جدید"/>
                                </Grid>

                                <!-- شخص فرعی ۱ -->
                                <TextBlock Text="شخص فرعی ۱ (ناظر / وکیل / طرف دوم)" FontSize="12" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbSubPerson1" Height="32" Margin="0,0,0,8"/>

                                <!-- شخص فرعی ۲ -->
                                <TextBlock Text="شخص فرعی ۲ (شاهد / رونوشت‌گیرنده)" FontSize="12" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbSubPerson2" Height="32"/>
                            </StackPanel>
                        </Border>

                        <!-- ۶. یادداشت‌ها و توضیحات -->
                        <TextBlock Text="یادداشت‌ها و دستورات اقدام روی سند" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNotes" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- ستون چپ: مدیریت تصاویر، برگه‌ها و متن OCR -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- نوار ابزار صفحات -->
                        <RowDefinition Height="110"/>  <!-- نوار بندانگشتی صفحات -->
                        <RowDefinition Height="*"/>    <!-- نمایشگر بزرگ تصویر -->
                        <RowDefinition Height="120"/>  <!-- کادر متن OCR -->
                    </Grid.RowDefinitions>

                    <!-- نوار ابزار مدیریت صفحات -->
                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="➕ افزودن تصویر سند" Click="BtnAddImage_Click" Width="140" Height="32" Background="#16A34A" Margin="0,0,8,0"/>
                                <Button Content="🗑️ حذف برگه انتخابی" Click="BtnRemovePage_Click" Width="130" Height="32" Background="#DC2626" Margin="0,0,8,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtPageCounter" Text="صفحات: ۰ برگه" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="🔍 استخراج متن (OCR)" Click="BtnRunOcr_Click" Width="155" Height="32" Background="#7C3AED" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
                                <Button Content="🗑️ حذف متن" Click="BtnClearOcr_Click" Width="95" Height="32" Background="#EF4444" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
                                <Button Content="📖 نمایش متن OCR" Click="BtnViewOcrPopup_Click" Width="120" Height="32" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- نوار بندانگشتی صفحات -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="4" Padding="6" Margin="0,0,0,8">
                        <ListBox x:Name="ListThumbnails" SelectionChanged="ListThumbnails_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="4" Margin="4,0" BorderBrush="#3B82F6" BorderThickness="1" Width="85" Height="90">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                            <TextBlock Grid.Row="1" Text="{Binding PageNumber, StringFormat='برگه {0}'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- نمایشگر تعاملی تصویر اصلی با زوم و چرخش -->
                    <ctrl:ImageViewerControl Grid.Row="2" x:Name="DocImageViewer" Margin="0,0,0,8"/>

                    <!-- کادر متن استخراج‌شده OCR -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📝 متن استخراج‌شده OCR (قابل ویرایش دستی جهت جستجوهای آینده):" FontSize="11.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="🔍 نمایش در پنجره بزرگ" Click="BtnViewOcrPopup_Click" Width="145" Height="26" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="TxtPageOcr" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- نوار دکمه‌های تایید و انصراف -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾 ذخیره سند در بایگانی" Click="BtnSave_Click" Width="170" Height="36" Background="#16A34A" FontWeight="Bold" FontSize="13.5" Margin="0,0,10,0"/>
                <Button Content="انصراف" Click="BtnCancel_Click" Width="110" Height="36" Background="#64748B"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
