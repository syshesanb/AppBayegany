<Window x:Class="BayeganyApp.Windows.BatchImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود دسته‌ای تصاویر و مدارک اسکن‌شده" 
        Height="540" Width="820"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ۱. هدر -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <TextBlock Text="📥 ورود دسته‌ای تصاویر نامه‌ها و قراردادها به بایگانی" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </Border>

        <!-- ۲. انتخاب پوشه و تنظیمات دسته -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="مسیر پوشه تصاویر: " FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtFolderPath" Height="34" IsReadOnly="True" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="📁 انتخاب پوشه..." Click="BtnSelectFolder_Click" Width="140" Height="34" Background="#1E3A8A"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="موضوع اصلی انتخابی:" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbBatchMainSubject" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2" Text="شخص اصلی انتخابی:" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="3" x:Name="CmbBatchMainPerson"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ۳. وضعیت و گزارش فایل‌ها -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="فهرست فایل‌های تصویری شناسایی‌شده:" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" x:Name="ListFoundFiles" Margin="0,0,0,8"/>
                <ProgressBar Grid.Row="2" x:Name="BatchProgressBar" Height="20" Minimum="0" Maximum="100" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- ۴. فوتر و دکمه شروع -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="پوشه حاوی تصاویر را انتخاب نمایید." Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnStartBatch" Content="🚀 شروع ورود دسته‌ای و فشرده‌سازی" Click="BtnStartBatch_Click" Width="240" Height="36" Background="#16A34A" FontWeight="Bold" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button Content="بستن" Click="BtnClose_Click" Width="90" Height="36" Background="#64748B"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
