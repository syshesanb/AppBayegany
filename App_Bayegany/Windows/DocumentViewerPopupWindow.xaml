<Window x:Class="BayeganyApp.Windows.DocumentViewerPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BayeganyApp.Controls"
        Title="👁️ مشاهده تصویر و اطلاعات کامل سند بایگانی"
        Width="1240" Height="860"
        MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#F1F5F9"
        FontFamily="Tahoma, Segoe UI">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- سربرگ اصلی پنجره -->
            <RowDefinition Height="Auto"/> <!-- کارت مشخصات سند -->
            <RowDefinition Height="*"/>    <!-- بدنه اصلی: پیش‌نمایش تصویر + کادر OCR -->
            <RowDefinition Height="Auto"/> <!-- نوار وضعیت پایین -->
        </Grid.RowDefinitions>

        <!-- ۱. نوار ابزار و سربرگ بالای پنجره -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👁️ نمایشگر اختصاصی تصویر و مشخصات سند" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <Border Background="#2563EB" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderBadge" Text="کد بایگانی: -" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✏️ ویرایش این سند" Click="BtnEditDoc_Click" Width="140" Height="34" Background="#0284C7" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand" ToolTip="باز کردن پنجره ویرایش اطلاعات و تصاویر این سند"/>
                    <Button Content="❌ بستن" Click="BtnClose_Click" Width="95" Height="34" Background="#64748B" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ۲. کارت مشخصات سند (نمایش جامع در ۳ سطر مجزا) -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- سطر ۱: مشخصات اداری سند -->
                    <RowDefinition Height="Auto"/> <!-- سطر ۲: اشخاص اصلی و فرعی اول و دوم -->
                    <RowDefinition Height="Auto"/> <!-- سطر ۳: دسته‌بندی موضوعی و یادداشت -->
                </Grid.RowDefinitions>

                <!-- سطر ۱: کد، شماره، تاریخ، نوع، برگه‌ها -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏛️ کد بایگانی: " FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock x:Name="TxtCodBayegany" Text="-" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔢 شماره مدرک: " FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock x:Name="TxtDocNumber" Text="-" Foreground="#0F172A"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅 تاریخ: " FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock x:Name="TxtDocDate" Text="-" Foreground="#0F172A"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📑 نوع مدرک: " FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock x:Name="TxtDocType" Text="-" Foreground="#0F172A"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📄 برگه‌ها: " FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock x:Name="TxtPageCount" Text="۰" Foreground="#0F172A"/>
                    </StackPanel>
                </Grid>

                <!-- سطر ۲: نمایش کامل و تفکیک‌شده اشخاص (اصلی، فرعی ۱، فرعی ۲) -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="👤 شخص اصلی: " FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock x:Name="TxtMainPerson" Text="-" FontWeight="SemiBold" Foreground="#0F172A" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="👥 شخص فرعی ۱: " FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock x:Name="TxtSubPerson1" Text="-" Foreground="#1E293B" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👥 شخص فرعی ۲: " FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock x:Name="TxtSubPerson2" Text="-" Foreground="#1E293B" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Grid>

                <!-- سطر ۳: دسته‌بندی موضوعی و یادداشت‌ها -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.8*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="📁 موضوع: " FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock x:Name="TxtSubjectPath" Text="-" Foreground="#1E293B" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📝 یادداشت: " FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock x:Name="TxtNotes" Text="-" Foreground="#475569" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ۳. بدنه اصلی دو بخشی (راست: نمایشگر بزرگ تصویر و نوار برگه‌ها | چپ: متن OCR) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*"/> <!-- تصویر و نوار برگه‌ها -->
                <ColumnDefinition Width="8"/>    <!-- اسپلیتر -->
                <ColumnDefinition Width="1*" MinWidth="320"/> <!-- متن OCR -->
            </Grid.ColumnDefinitions>

            <!-- بخش تصویر و نوار برگه‌ها -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- نوار بندانگشتی برگه‌ها -->
                        <RowDefinition Height="*"/>    <!-- نمایشگر تصویر -->
                    </Grid.RowDefinitions>

                    <!-- نوار بندانگشتی صفحات سند -->
                    <Border Grid.Row="0" Background="#0F172A" CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📑 صفحات سند:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ListBox Grid.Column="1" x:Name="ListPagesThumbnails" SelectionChanged="ListPagesThumbnails_SelectionChanged" 
                                     Background="Transparent" BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="3" Margin="3,0" BorderBrush="#3B82F6" BorderThickness="1" Width="72" Height="74" Cursor="Hand">
                                            <Grid>
                                                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                                <Border Background="#B00F172A" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="4,1" Margin="2">
                                                    <TextBlock Text="{Binding PageNumber, StringFormat='برگه {0}'}" FontSize="9.5" Foreground="#E2E8F0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- نمایشگر اختصاصی و تعاملی تصویر با زوم و چرخش -->
                    <ctrl:ImageViewerControl Grid.Row="1" x:Name="DocImageViewer"/>
                </Grid>
            </Border>

            <!-- اسپلیتر تغییر عرض دو ستون -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CBD5E1" ShowsPreview="True" Cursor="SizeWE"/>

            <!-- بخش متن استخراج‌شده OCR -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- سربرگ OCR و دکمه کپی -->
                        <RowDefinition Height="Auto"/> <!-- اطلاعات برگه یا هایلایت جستجو -->
                        <RowDefinition Height="*"/>    <!-- متن کامل OCR -->
                    </Grid.RowDefinitions>

                    <!-- سربرگ OCR -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtOcrHeader" Text="📝 متن استخراج‌شده OCR" FontSize="13.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <TextBlock x:Name="TxtOcrSubHeader" Text="متن شناسایی‌شده از روی تصویر برگه" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📋 کپی کل متن" Click="BtnCopyOcr_Click" Width="105" Height="30" FontSize="11.5" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                    </Grid>

                    <!-- نشانگر کلمه جستجو شده (در صورت جستجوی OCR) -->
                    <Border Grid.Row="1" x:Name="BorderOcrHighlight" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock x:Name="TxtOcrMatchInfo" Text="🔍 تطبیق با عبارت جستجو: -" Foreground="#92400E" FontSize="11.5" FontWeight="SemiBold"/>
                    </Border>

                    <!-- کادر بزرگ نمایش متن OCR -->
                    <TextBox Grid.Row="2" x:Name="TxtOcrContent" 
                             IsReadOnly="True" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Disabled" 
                             FontSize="13.5" 
                             Padding="10" 
                             Background="#F8FAFC" 
                             Foreground="#0F172A" 
                             BorderBrush="#CBD5E1" 
                             BorderThickness="1"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ۴. نوار وضعیت پایین صفحه -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="4" Padding="12,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="برای بزرگنمایی از غلتک ماوس (همراه با کلید Ctrl) یا دکمه‌های ابزار استفاده فرمایید." Foreground="#94A3B8" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="سامانه بایگانی اسناد و مدارک" Foreground="#64748B" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
