<Window x:Class="BayeganyApp.Windows.ManageUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت کاربران و تعیین سطوح دسترسی" 
        Height="700" Width="1160"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F1F5F9">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- سربرگ -->
            <RowDefinition Height="*"/>    <!-- بدنه دو ستونه (لیست کاربران + فرم مشخصات و مجوزها) -->
            <RowDefinition Height="Auto"/> <!-- دکمه بستن -->
        </Grid.RowDefinitions>

        <!-- ۱. سربرگ -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥 مدیریت کاربران و تعیین سطوح دسترسی" Foreground="White" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="(تعریف کاربر، تخصیص نقش، تعیین مجوزهای تفکیکی)" Foreground="#93C5FD" FontSize="12" Margin="10,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="سامانه بایگانی اسناد" Foreground="#BFDBFE" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ۲. بدنه اصلی -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>       <!-- لیست کاربران -->
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="420"/>     <!-- فرم تعریف و ویرایش مشخصات و مجوزها -->
            </Grid.ColumnDefinitions>

            <!-- جدول لیست کاربران -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📋 فهرست کاربران سیستم:" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13"/>
                        <Button Grid.Column="2" Content="➕ کاربر جدید" Click="BtnNewUser_Click" Background="#16A34A" Foreground="White" FontWeight="Bold" Height="30" Padding="10,2"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DgUsers" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgUsers_SelectionChanged"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="36" AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#E2E8F0" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شناسه" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="نام کاربری" Binding="{Binding Username}" Width="110"/>
                            <DataGridTextColumn Header="نام و نام خانوادگی" Binding="{Binding FullName}" Width="150"/>
                            <DataGridTextColumn Header="نقش کاربری" Binding="{Binding RoleTitle}" Width="160"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusTitle}" Width="75"/>
                            <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding CreatedAt}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- دکمه‌های عملیات روی کاربر انتخابی -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="🗑️ حذف کاربر انتخابی" Click="BtnDeleteUser_Click" Background="#DC2626" Foreground="White" Height="32" Padding="12,4" Margin="0,0,8,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- فرم ثبت و ویرایش کاربر و سطوح دسترسی -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtFormTitle" Text="➕ تعریف کاربر جدید" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13.5" Margin="0,0,0,12"/>

                        <!-- نام کامل -->
                        <TextBlock Text="نام و نام خانوادگی: *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtFullName" Height="34" Margin="0,0,0,10"/>

                        <!-- نام کاربری -->
                        <TextBlock Text="نام کاربری: *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUsername" Height="34" Margin="0,0,0,10"/>

                        <!-- کلمه عبور -->
                        <TextBlock x:Name="LblPassword" Text="کلمه عبور (رمز ورود): *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtPassword" Height="34" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtPasswordHint" Text="* حداقل ۳ کاراکتر" Foreground="#64748B" FontSize="11" Margin="0,0,0,10"/>

                        <!-- انتخاب نقش پیش‌فرض -->
                        <TextBlock Text="نقش کاربری پیش‌فرض:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbRole" Height="34" SelectionChanged="CmbRole_SelectionChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="مدیر سیستم (دسترسی کامل)"/>
                            <ComboBoxItem Content="اپراتور بایگانی (ثبت و ویرایش)"/>
                            <ComboBoxItem Content="مشاهده‌گر / کارشناس (فقط خواندنی)"/>
                            <ComboBoxItem Content="سفارشی (تعیین دستی دسترسی‌ها)"/>
                        </ComboBox>

                        <!-- وضعیت فعال بودن -->
                        <CheckBox x:Name="ChkIsActive" Content="حساب کاربری فعال است" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- تعیین سطوح و مجوزهای تفکیکی -->
                        <GroupBox Header="🔒 مجوزها و سطوح دسترسی تفکیکی" Foreground="#1E3A8A" FontWeight="Bold" Margin="0,0,0,14" Padding="10">
                            <StackPanel TextElement.FontWeight="Normal">
                                <CheckBox x:Name="ChkCanAddDoc" Content="➕ ثبت مدرک جدید در بایگانی" IsChecked="True" Margin="0,3"/>
                                <CheckBox x:Name="ChkCanEditDoc" Content="✏️ ویرایش مشخصات و تصاویر مدارک" IsChecked="True" Margin="0,3"/>
                                <CheckBox x:Name="ChkCanDeleteDoc" Content="🗑️ امکان حذف اسناد از سیستم" IsChecked="False" Margin="0,3"/>
                                <Separator Margin="0,6"/>
                                <CheckBox x:Name="ChkCanManagePersons" Content="👥 مدیریت مرجع اشخاص و شرکت‌ها" IsChecked="True" Margin="0,3"/>
                                <CheckBox x:Name="ChkCanManageSubjects" Content="📁 مدیریت درخت موضوعات بایگانی" IsChecked="True" Margin="0,3"/>
                                <CheckBox x:Name="ChkCanViewReports" Content="📊 گزارش‌گیری جامع و جستجوی پیشرفته" IsChecked="True" Margin="0,3"/>
                                <Separator Margin="0,6"/>
                                <CheckBox x:Name="ChkCanBackupRestore" Content="💾 پشتیبان‌گیری و بازیابی پایگاه‌داده" IsChecked="False" Margin="0,3"/>
                                <CheckBox x:Name="ChkCanManageUsers" Content="🔐 مدیریت کاربران و تعیین دسترسی‌ها" IsChecked="False" Margin="0,3"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- دکمه‌های فرم -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnSaveUser" Content="💾 ذخیره اطلاعات" Click="BtnSaveUser_Click" Background="#16A34A" Foreground="White" FontWeight="Bold" Height="36"/>
                            <Button Grid.Column="2" Content="🔄 پاک‌کردن فرم" Click="BtnClearForm_Click" Background="#64748B" Foreground="White" Height="36"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ۳. نوار وضعیت و دکمه بستن پنجره -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatus" Text="تعداد کل کاربران: -" Foreground="#475569" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="بستن پنجره" Click="BtnClose_Click" Width="100" Height="32" Background="#334155" Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</Window>
