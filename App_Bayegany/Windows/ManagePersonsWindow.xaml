<Window x:Class="BayeganyApp.Windows.ManagePersonsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت اشخاص حقیقی و سازمان‌های حقوقی" 
        Height="760" Width="1140"
        MinHeight="620" MinWidth="950"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ۱. هدر پنجره -->
        <Border Grid.Row="0" Background="#047857" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="👥 مدیریت مرجع اشخاص حقیقی و شرکت‌ها" Foreground="White" FontSize="15" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="سامانه بایگانی اسناد" Foreground="#A7F3D0" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ۲. فرم ورود و ویرایش مشخصات شخص -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="نام کامل / عنوان شرکت: *" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtFullName" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="2" Text="نوع شخص:" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="3" x:Name="CmbPersonType" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="4" Text="کد/شناسه ملی:" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="5" x:Name="TxtNationalCode"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="اطلاعات تماس:" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtContactInfo" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="2" Text="توضیحات / یادداشت:" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="3" x:Name="TxtPersonNotes" Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button x:Name="BtnSavePerson" Content="➕ ثبت شخص جدید" Click="BtnSavePerson_Click" Width="145" Height="34" Background="#16A34A" FontWeight="Bold"/>
                        <Button x:Name="BtnCancelEdit" Content="❌ انصراف" Click="BtnCancelEdit_Click" Width="85" Height="34" Background="#64748B" Margin="6,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ۳. جدول لیست اشخاص با ستون عملیات -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
            <DataGrid x:Name="GridPersons" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شناسه" Binding="{Binding Id}" Width="65"/>
                    <DataGridTextColumn Header="نام کامل / شرکت" Binding="{Binding FullName}" Width="*" FontWeight="Bold"/>
                    <DataGridTextColumn Header="نوع شخص" Binding="{Binding PersonType}" Width="140"/>
                    <DataGridTextColumn Header="کد ملی / شناسه" Binding="{Binding NationalCode}" Width="130"/>
                    <DataGridTextColumn Header="اطلاعات تماس" Binding="{Binding ContactInfo}" Width="150"/>
                    <DataGridTextColumn Header="توضیحات" Binding="{Binding Notes}" Width="180"/>

                    <!-- ستون دکمه‌های عملیات: انتخاب، ویرایش و حذف -->
                    <DataGridTemplateColumn Header="عملیات" Width="135">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- دکمه انتخاب با آیکن (فقط در صورت قرار داشتن در حالت انتخاب فعال است) -->
                                    <Button Click="BtnSelectRow_Click" Tag="{Binding}" 
                                            IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsSelectionMode}"
                                            Width="32" Height="28" Margin="2,0" 
                                            Background="#10B981" Foreground="White" 
                                            ToolTip="انتخاب شخص">
                                        <TextBlock Text="✔️" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- دکمه ویرایش با آیکن -->
                                    <Button Click="BtnEditRow_Click" Tag="{Binding}" 
                                            Width="32" Height="28" Margin="2,0" 
                                            Background="#0284C7" Foreground="White" 
                                            ToolTip="ویرایش اطلاعات شخص">
                                        <TextBlock Text="✏️" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- دکمه حذف با آیکن -->
                                    <Button Click="BtnDeleteRow_Click" Tag="{Binding}" 
                                            Width="32" Height="28" Margin="2,0" 
                                            Background="#DC2626" Foreground="White" 
                                            ToolTip="حذف شخص از سیستم">
                                        <TextBlock Text="🗑️" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ۴. فوتر -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="بستن پنجره" Click="BtnClose_Click" Width="110" Height="34" Background="#64748B"/>
                <TextBlock Grid.Column="2" x:Name="TxtRecordCount" Text="تعداد اشخاص ثبت‌شده: ۰" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
