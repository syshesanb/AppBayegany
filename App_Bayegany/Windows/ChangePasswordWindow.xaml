<Window x:Class="BayeganyApp.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغییر نام کاربری و کلمه عبور" 
        Height="490" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F1F5F9">

    <Border Background="White" Margin="14" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- هدر -->
                <RowDefinition Height="*"/>    <!-- فیلدها -->
                <RowDefinition Height="Auto"/> <!-- دکمه‌ها -->
            </Grid.RowDefinitions>

            <!-- ۱. هدر -->
            <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="7,7,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔑 تغییر مشخصات و رمز عبور کاربری" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" x:Name="TxtHeaderUser" Text="کاربر" Foreground="#93C5FD" FontSize="11.5" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ۲. بدنه فرم -->
            <StackPanel Grid.Row="1" Margin="20,16,20,10">
                <!-- نام و نام خانوادگی -->
                <TextBlock Text="نام و نام خانوادگی:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtFullName" Height="34" Margin="0,0,0,10"/>

                <!-- نام کاربری جدید -->
                <TextBlock Text="نام کاربری جدید:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUsername" Height="34" Margin="0,0,0,10"/>

                <!-- کلمه عبور فعلی -->
                <TextBlock Text="کلمه عبور فعلی (جهت احراز هویت): *" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtCurrentPassword" Height="34" Margin="0,0,0,10"/>

                <!-- کلمه عبور جدید -->
                <TextBlock Text="کلمه عبور جدید (در صورت تمایل به تغییر):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtNewPassword" Height="34" Margin="0,0,0,10"/>

                <!-- تکرار کلمه عبور جدید -->
                <TextBlock Text="تکرار کلمه عبور جدید:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtConfirmPassword" Height="34" Margin="0,0,0,10"/>

                <!-- راهنما -->
                <TextBlock Text="* اگر قصد تغییر کلمه عبور را ندارید، فیلدهای جدید را خالی بگذارید." Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ۳. دکمه‌ها -->
            <Grid Grid.Row="2" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="💾 ذخیره تغییرات" Click="BtnSave_Click" Height="36" Background="#16A34A" Foreground="White" FontWeight="Bold"/>
                <Button Grid.Column="2" Content="انصراف" Click="BtnCancel_Click" IsCancel="True" Height="36" Background="#64748B" Foreground="White"/>
            </Grid>
        </Grid>
    </Border>
</Window>
