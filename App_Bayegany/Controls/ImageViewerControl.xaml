<UserControl x:Class="BayeganyApp.Controls.ImageViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- نوار ابزار زوم و چرخش تصویر -->
        <Border Grid.Row="0" Background="#1E293B" Padding="10,6" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="🔍➕ بزرگنمایی" Click="BtnZoomIn_Click" Width="95" Height="30" Margin="3,0" Background="#334155" FontSize="11.5"/>
                <Button Content="🔍➖ کوچک‌نمایی" Click="BtnZoomOut_Click" Width="95" Height="30" Margin="3,0" Background="#334155" FontSize="11.5"/>
                <Button Content="🔄 چرخش ۹۰ درجه" Click="BtnRotate_Click" Width="110" Height="30" Margin="3,0" Background="#334155" FontSize="11.5"/>
                <Button Content="📐 تناسب با صفحه" Click="BtnFit_Click" Width="110" Height="30" Margin="3,0" Background="#334155" FontSize="11.5"/>
                <Button Content="⏹ اندازه واقعی (۱۰۰٪)" Click="BtnReset_Click" Width="120" Height="30" Margin="3,0" Background="#334155" FontSize="11.5"/>
                <Button x:Name="BtnCrop" Content="✂️ برش و کراپ تصویر" Click="BtnCrop_Click" Width="135" Height="30" Margin="4,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11.5"/>
            </StackPanel>
        </Border>

        <!-- نمایشگر تصویر قابل اسکرول و جابه‌جایی با ماوس -->
        <ScrollViewer Grid.Row="1" x:Name="ImgScrollViewer" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      MouseDown="ScrollViewer_MouseDown"
                      MouseMove="ScrollViewer_MouseMove"
                      MouseUp="ScrollViewer_MouseUp"
                      Cursor="Hand">
            <Grid x:Name="ImageGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="MainImage" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScaleTrans" ScaleX="1.0" ScaleY="1.0"/>
                            <RotateTransform x:Name="RotateTrans" Angle="0"/>
                        </TransformGroup>
                    </Image.LayoutTransform>
                </Image>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
