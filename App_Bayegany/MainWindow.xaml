<Window x:Class="BayeganyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BayeganyApp.Controls"
        Title="سامانه جامع و هوشمند بایگانی اسناد و مدارک" 
        Height="840" Width="1380"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F1F5F9">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- نوار ابزار اصلی بالای صفحه -->
            <RowDefinition Height="*"/>    <!-- بدنه سه‌بخشی (فیلترها | جدول اسناد | نمایشگر تصویر) -->
            <RowDefinition Height="Auto"/> <!-- نوار وضعیت پایین صفحه -->
        </Grid.RowDefinitions>

        <!-- ۱. نوار ابزار اصلی بالای صفحه -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏛️ سامانه هوشمند بایگانی اسناد و مدارک" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text=" (نسخه ۱.۰ | WPF &amp; SQLite)" Foreground="#93C5FD" FontSize="12.5" Margin="8,2,0,0"/>
                </StackPanel>

                <!-- دکمه‌های عملیاتی -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ ثبت مدرک جدید" Click="BtnNewDoc_Click" Width="150" Height="36" Background="#16A34A" FontWeight="Bold" Margin="0,0,8,0"/>
                    <Button Content="📊 گزارش‌گیری جامع و ماتریسی" Click="BtnOpenReport_Click" Width="210" Height="36" Background="#0284C7" FontWeight="Bold" Margin="0,0,8,0" ToolTip="گزارش چندبعدی موضوعات سه‌سطحی و اشخاص سه‌گانه"/>
                    <Button Content="👥 اشخاص" Click="BtnManagePersons_Click" Width="95" Height="36" Background="#334155" Margin="0,0,8,0"/>
                    <Button Content="📁 موضوعات" Click="BtnManageSubjects_Click" Width="95" Height="36" Background="#334155" Margin="0,0,8,0"/>
                    <Button Content="💾 پشتیبان‌گیری" Click="BtnBackup_Click" Width="110" Height="36" Background="#334155"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ۲. بدنه اصلی (فیلترهای سه‌ردیفه افقی + جدول اسناد بایگانی تمام‌عرض) -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- پنل افقی فیلترهای سه‌ردیفه -->
                <RowDefinition Height="*"/>    <!-- جدول اسناد بایگانی تمام‌عرض -->
            </Grid.RowDefinitions>

            <!-- پنل افقی جستجو و فیلترها در ۳ ردیف -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- عنوان -->
                            <RowDefinition Height="Auto"/> <!-- ردیف ۱: جستجوی سریع | نوع مدرک | شخص/شرکت مرتبط -->
                            <RowDefinition Height="Auto"/> <!-- ردیف ۲: موضوع اصلی | موضوع فرعی ۱ | موضوع فرعی ۲ -->
                            <RowDefinition Height="Auto"/> <!-- ردیف ۳: بازه تاریخ صدور (از - تا) | دکمه پاک‌کردن فیلترها -->
                        </Grid.RowDefinitions>

                        <!-- سربرگ پنل فیلترها -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍 جستجو و فیلتر پیشرفته اسناد" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13.5"/>
                                <TextBlock Text="(فیلترهای ترکیبی افقی بالا + فیلترهای هوشمند در بالای هر ستون جدول)" Foreground="#64748B" FontSize="11" Margin="8,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ردیف ۱: جستجوی سریع (کد، نام، OCR) | نوع مدرک | شخص / شرکت مرتبط -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="جستجوی عمومی (کد بایگانی، شماره، یادداشت):" FontSize="11.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox Grid.Row="1" x:Name="TxtSearchBox" Height="32" TextChanged="FilterChanged" ToolTip="جستجو در تمام فیلدهای اصلی اسناد"/>
                            </Grid>

                            <Grid Grid.Column="1" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="نوع مدرک:" FontSize="11.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <ComboBox Grid.Row="1" x:Name="CmbFilterDocType" SelectionChanged="FilterChanged" Height="32"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="👤 شخص / شرکت مرتبط:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <ComboBox Grid.Row="1" x:Name="CmbFilterPerson" SelectionChanged="FilterChanged" Height="32"/>
                            </Grid>
                        </Grid>

                        <!-- ردیف ۲: موضوع اصلی | موضوع فرعی ۱ | موضوع فرعی ۲ -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📁 موضوع اصلی:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <ComboBox Grid.Row="1" x:Name="CmbFilterMainSubject" SelectionChanged="CmbFilterMainSubject_SelectionChanged" Height="32"/>
                            </Grid>

                            <Grid Grid.Column="1" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📂 موضوع فرعی ۱:" FontSize="11.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <ComboBox Grid.Row="1" x:Name="CmbFilterSubSubject1" SelectionChanged="CmbFilterSubSubject1_SelectionChanged" Height="32" IsEnabled="False"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📄 موضوع فرعی ۲:" FontSize="11.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <ComboBox Grid.Row="1" x:Name="CmbFilterSubSubject2" SelectionChanged="FilterChanged" Height="32" IsEnabled="False"/>
                            </Grid>
                        </Grid>

                        <!-- ردیف ۳: فیلتر ویژه متن OCR | بازه تاریخ صدور (از - تا) | دکمه پاک‌کردن فیلترها -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- فیلتر ویژه متن OCR -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🔍📖 جستجوی ویژه در متن OCR (داخل اسناد):" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9" Margin="0,0,0,3"/>
                                <TextBox Grid.Row="1" x:Name="TxtFilterOcr" Height="32" TextChanged="FilterChanged" 
                                         Background="#FAF5FF" BorderBrush="#8B5CF6" BorderThickness="1.5"
                                         ToolTip="فیلتر کردن اسناد منحصراً بر اساس متن استخراج‌شده از تصویر سند توسط OCR"/>
                            </Grid>

                            <!-- از تاریخ -->
                            <Grid Grid.Column="1" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📅 از تاریخ صدور:" FontSize="11.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtFilterFromDate" TextChanged="FilterChanged" Height="32" ToolTip="مثلا ۱۴۰۵/۰۱/۰۱"/>
                                    <Button Grid.Column="1" Content="📆" Click="BtnPickFromDate_Click" Width="34" Height="32" Margin="3,0,0,0" Background="#E2E8F0" Foreground="#1E293B"/>
                                </Grid>
                            </Grid>

                            <!-- تا تاریخ -->
                            <Grid Grid.Column="2" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📅 تا تاریخ صدور:" FontSize="11.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtFilterToDate" TextChanged="FilterChanged" Height="32" ToolTip="مثلا ۱۴۰۵/۱۲/۲۹"/>
                                    <Button Grid.Column="1" Content="📆" Click="BtnPickToDate_Click" Width="34" Height="32" Margin="3,0,0,0" Background="#E2E8F0" Foreground="#1E293B"/>
                                </Grid>
                            </Grid>

                            <!-- دکمه پاک‌کردن فیلترها -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <Button Content="🔄 پاک‌کردن فیلترها" Click="BtnClearFilters_Click" Height="32" Width="150" Background="#64748B" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- کارت جدول اصلی اسناد بایگانی -->
                <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- نوار وضعیت و ابزار جدول -->
                        <Border Grid.Row="0" Background="#F8FAFC" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtDocCountHeader" Text="فهرست اسناد بایگانی (تعداد: ۰ سند)" FontWeight="Bold" Foreground="#1E3A8A"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="✏️ ویرایش سند" Click="BtnEditSelectedDoc_Click" Width="105" Height="30" Background="#0284C7" Margin="0,0,6,0"/>
                                    <Button Content="🗑️ حذف سند" Click="BtnDeleteSelectedDoc_Click" Width="95" Height="30" Background="#DC2626"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- جدول اصلی اسناد با فیلترهای هم‌عرض در سربرگ هر ستون -->
                        <DataGrid Grid.Row="1" x:Name="GridDocuments" AutoGenerateColumns="False" SelectionChanged="GridDocuments_SelectionChanged" MouseDoubleClick="GridDocuments_MouseDoubleClick">
                            <DataGrid.Columns>
                                <!-- ستون دکمه مشاهده اختصاصی تصویر و اطلاعات سند (بدون متن، با آیکون) -->
                                <DataGridTemplateColumn Width="56" CanUserResize="False">
                                    <DataGridTemplateColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="تصویر" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <Border Grid.Row="1" Height="25"/>
                                        </Grid>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="BtnViewDocPopup_Click" Tag="{Binding}" 
                                                    Width="36" Height="28" 
                                                    Background="#0284C7" Foreground="White" 
                                                    BorderBrush="#0369A1" BorderThickness="1"
                                                    Cursor="Hand" ToolTip="مشاهده کامل تصویر و مشخصات سند در پنجره پاپ‌آپ بزرگ">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                                <TextBlock Text="👁️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ستون تصویر بندانگشتی -->
                                <DataGridTemplateColumn Width="60" CanUserResize="False">
                                    <DataGridTemplateColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="پیش‌نمایش" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <Border Grid.Row="1" Height="25"/>
                                        </Grid>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding ThumbnailImage}" Width="40" Height="34" Stretch="Uniform" Margin="2" 
                                                   Cursor="Hand" ToolTip="کلیک برای مشاهده کامل سند" 
                                                   MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- کد بایگانی -->
                                <DataGridTextColumn Binding="{Binding CodBayegany}" Width="110" FontWeight="Bold">
                                    <DataGridTextColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="کد بایگانی" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterCodBayegany" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر کد بایگانی"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- شماره مدرک -->
                                <DataGridTextColumn Binding="{Binding DocNumber}" Width="105">
                                    <DataGridTextColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="شماره مدرک" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterDocNumber" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر شماره مدرک"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- تاریخ سند -->
                                <DataGridTextColumn Binding="{Binding DocDate}" Width="95">
                                    <DataGridTextColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="تاریخ سند" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterDocDate" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر تاریخ سند"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- نوع مدرک -->
                                <DataGridTextColumn Binding="{Binding DocType}" Width="105">
                                    <DataGridTextColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="نوع مدرک" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterDocType" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر نوع مدرک"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- مسیر دسته‌بندی موضوعی -->
                                <DataGridTextColumn Binding="{Binding FullSubjectPath}" Width="180">
                                    <DataGridTextColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="دسته‌بندی موضوعی" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterSubject" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر موضوع"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- شخص اصلی مرتبط -->
                                <DataGridTextColumn Binding="{Binding MainPersonName}" Width="150" FontWeight="SemiBold">
                                    <DataGridTextColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="شخص اصلی مرتبط" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterPerson" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر شخص مرتبط"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- برگه‌ها -->
                                <DataGridTextColumn Binding="{Binding PageCount}" Width="65">
                                    <DataGridTextColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="برگه‌ها" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterPageCount" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر تعداد برگه‌ها"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- یادداشت‌ها -->
                                <DataGridTextColumn Binding="{Binding Notes}" Width="*">
                                    <DataGridTextColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="یادداشت‌ها" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterNotes" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر یادداشت‌ها"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- متن OCR استخراج شده -->
                                <DataGridTemplateColumn Width="150">
                                    <DataGridTemplateColumn.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="متن OCR" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Margin="0,2,0,4"/>
                                            <TextBox Grid.Row="1" x:Name="ColFilterOcr" Height="25" FontSize="11" Padding="4,2" 
                                                     Background="White" Foreground="#0F172A" BorderBrush="#93C5FD" BorderThickness="1"
                                                     HorizontalAlignment="Stretch" Margin="2,0" ToolTip="فیلتر متن OCR"
                                                     TextChanged="ColFilter_TextChanged"
                                                     PreviewMouseLeftButtonDown="FilterTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OcrSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullOcrText}" VerticalAlignment="Center" Margin="4,0" FontSize="11.5" Foreground="#475569"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
        </Grid>

        <!-- ۳. نوار وضعیت پایین صفحه -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="4" Padding="12,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBottom" Text="نرم‌افزار بایگانی آماده به کار است." Foreground="#94A3B8" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="موتور دیتابیس: SQLite محلی (BLOB + FTS5)" Foreground="#64748B" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
