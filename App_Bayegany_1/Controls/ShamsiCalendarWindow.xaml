<Window x:Class="BayeganyApp.Controls.ShamsiCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب تاریخ شمسی" 
        Height="370" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Prev, Month & Year Selection, Next -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPrevMonth" Content="◀" Click="BtnPrevMonth_Click" Width="36" Height="32" Background="#E2E8F0" Foreground="#1E293B" Margin="2,0"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <ComboBox x:Name="CmbMonth" SelectionChanged="CmbMonth_SelectionChanged" Width="105" Margin="2,0"/>
                <ComboBox x:Name="CmbYear" SelectionChanged="CmbYear_SelectionChanged" Width="80" Margin="2,0"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="BtnNextMonth" Content="▶" Click="BtnNextMonth_Click" Width="36" Height="32" Background="#E2E8F0" Foreground="#1E293B" Margin="2,0"/>
        </Grid>

        <!-- Days Header (شنبه تا جمعه) -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
            <TextBlock Text="ش" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
            <TextBlock Text="ی" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
            <TextBlock Text="د" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
            <TextBlock Text="س" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
            <TextBlock Text="چ" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
            <TextBlock Text="پ" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
            <TextBlock Text="ج" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#DC2626"/>
        </UniformGrid>

        <!-- Days Grid -->
        <UniformGrid Grid.Row="2" x:Name="GridDays" Columns="7"/>

        <!-- Footer: Today & Cancel -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="📅 انتخاب تاریخ امروز" Click="BtnToday_Click" Background="#16A34A" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="انصراف" Click="BtnCancel_Click" Background="#64748B" Margin="4,0,0,0"/>
        </Grid>
    </Grid>
</Window>
