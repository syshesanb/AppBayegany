<Window x:Class="BayeganyApp.Windows.CropImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✂️ ابزار هوشمند کراپ و برش حاشیه‌های تصویر سند"
        Width="1100" Height="780"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#0F172A"
        Foreground="White"
        FontFamily="Tahoma, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- سربرگ راهنما و ابزارها -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="✂️ برش و حذف فضاهای اضافی تصویر مدرک" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="کلیک چپ ماوس را نگه داشته و کادر مورد نظر را روی بخش اصلی سند بکشید تا حاشیه‌های اضافی حذف شوند." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 چرخش ۹۰ درجه راست" Click="BtnRotateRight_Click" Width="145" Height="32" Background="#334155" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" FontSize="11.5"/>
                    <Button Content="🔄 چرخش ۹۰ درجه چپ" Click="BtnRotateLeft_Click" Width="145" Height="32" Background="#334155" Foreground="White" FontWeight="Bold" Margin="0,0,12,0" FontSize="11.5"/>
                    <Border Background="#0F172A" CornerRadius="4" Padding="10,4" BorderBrush="#475569" BorderThickness="1">
                        <TextBlock x:Name="TxtCropDimensions" Text="کادر برش: هنوز انتخابی انجام نشده است" FontSize="12" FontWeight="SemiBold" Foreground="#FDE047" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- محیط انتخاب و نمایش تصویر (دقت: حتماً LeftToRight برای انطباق 1:1 مختصات تصویر و ماوس) -->
        <Border Grid.Row="1" Background="#020617" Margin="10" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" ClipToBounds="True">
            <Grid x:Name="ImageContainer" FlowDirection="LeftToRight" SizeChanged="ImageContainer_SizeChanged">
                <Image x:Name="SourceImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                
                <!-- بوم لایه ماسک و کادر انتخاب با FlowDirection="LeftToRight" -->
                <Canvas x:Name="SelectionCanvas" FlowDirection="LeftToRight" Background="Transparent"
                        MouseDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseUp="Canvas_MouseUp"
                        Cursor="Cross">
                    <!-- ماسک‌های تاریک ۴ طرف -->
                    <Rectangle x:Name="MaskTop" Fill="#B3000000"/>
                    <Rectangle x:Name="MaskBottom" Fill="#B3000000"/>
                    <Rectangle x:Name="MaskLeft" Fill="#B3000000"/>
                    <Rectangle x:Name="MaskRight" Fill="#B3000000"/>

                    <!-- کادر انتخاب برش با حاشیه نقطه‌چین برجسته -->
                    <Rectangle x:Name="CropBox"
                               Stroke="#38BDF8" StrokeThickness="2.5"
                               StrokeDashArray="4 2"
                               Fill="#1538BDF8"
                               Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- دکمه‌های کنترل و اعمال -->
        <Border Grid.Row="2" Background="#1E293B" Padding="16,12" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="🔄 انتخاب کل تصویر" Click="BtnSelectAll_Click" Width="140" Height="36" Background="#334155" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Content="↩️ پاک کردن کادر" Click="BtnResetSelection_Click" Width="130" Height="36" Background="#475569" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="✅ تایید و اعمال برش" Click="BtnApply_Click" Width="160" Height="36" Background="#16A34A" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Content="❌ انصراف" Click="BtnCancel_Click" Width="110" Height="36" Background="#64748B" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
