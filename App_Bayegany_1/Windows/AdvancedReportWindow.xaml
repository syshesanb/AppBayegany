<Window x:Class="BayeganyApp.Windows.AdvancedReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="گزارش‌گیری جامع و ماتریسی اسناد (موضوعات ۳ سطحی × اشخاص ۳ گانه)" 
        Height="780" Width="1240"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#F1F5F9">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- هدر پنجره -->
            <RowDefinition Height="Auto"/> <!-- کارت‌های خلاصه آماری KPI -->
            <RowDefinition Height="Auto"/> <!-- پنل فیلترهای ماتریسی -->
            <RowDefinition Height="*"/>    <!-- جدول نتایج گزارش -->
            <RowDefinition Height="Auto"/> <!-- نوار ابزار دکمه‌های خروجی و پرینت -->
        </Grid.RowDefinitions>

        <!-- ۱. هدر پنجره -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="16,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 موتور گزارش‌گیری ماتریسی و تحلیلی اسناد" Foreground="#60A5FA" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text=" | تفکیک درختی موضوعات، اشخاص سه‌گانه و فیلترهای چندبعدی" Foreground="#E2E8F0" FontSize="13" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="❌ بستن" Click="BtnClose_Click" Width="85" Height="30" Background="#EF4444" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ۲. کارت‌های آماری فوقانی (KPI Cards) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- کارت ۱: تعداد اسناد -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="تعداد کل اسناد منطبق" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalDocs" Text="۰ سند" Foreground="#1E3A8A" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- کارت ۲: مجموع برگه‌ها -->
            <Border Grid.Column="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="مجموع کل صفحات و برگه‌ها" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalPages" Text="۰ برگه" Foreground="#0D9488" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- کارت ۳: اولین تاریخ سند -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="قدیمی‌ترین تاریخ سند" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtMinDate" Text="-" Foreground="#D97706" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- کارت ۴: آخرین تاریخ سند -->
            <Border Grid.Column="3" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="جدیدترین تاریخ سند" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtMaxDate" Text="-" Foreground="#2563EB" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ۳. پنل فیلترهای ترکیبی و ماتریسی -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ردیف اول فیلترها: موضوعات سه‌گانه آبشاری -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📁 موضوع اصلی:" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbMainSubject" SelectionChanged="CmbMainSubject_SelectionChanged" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="2" Text="📂 موضوع فرعی ۱:" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="3" x:Name="CmbSubSubject1" SelectionChanged="CmbSubSubject1_SelectionChanged" IsEnabled="False" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="4" Text="📄 موضوع فرعی ۲:" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="5" x:Name="CmbSubSubject2" SelectionChanged="CmbSubSubject2_SelectionChanged" IsEnabled="False" Margin="0,0,12,0"/>

                    <Button Grid.Column="6" Content="پاک‌کردن موضوع" Click="BtnClearSubjectFilter_Click" Width="105" Height="32" Background="#94A3B8" FontSize="11.5"/>
                </Grid>

                <!-- ردیف دوم فیلترها: اشخاص سه‌گانه مرتبط -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="👤 شخص اصلی:" FontWeight="Bold" Foreground="#047857" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbMainPerson" SelectionChanged="FilterInputs_Changed" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="2" Text="👥 شخص فرعی ۱:" FontWeight="Bold" Foreground="#047857" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="3" x:Name="CmbSubPerson1" SelectionChanged="FilterInputs_Changed" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="4" Text="👥 شخص فرعی ۲:" FontWeight="Bold" Foreground="#047857" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="5" x:Name="CmbSubPerson2" SelectionChanged="FilterInputs_Changed" Margin="0,0,12,0"/>

                    <Button Grid.Column="6" Content="پاک‌کردن اشخاص" Click="BtnClearPersonFilter_Click" Width="105" Height="32" Background="#94A3B8" FontSize="11.5"/>
                </Grid>

                <!-- ردیف سوم فیلترها: تاریخ، نوع مدرک و جستجوی متن -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- تاریخ از -->
                    <TextBlock Grid.Column="0" Text="📅 از تاریخ:" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtFromDate" TextChanged="FilterInputs_Changed"/>
                    <Button Grid.Column="2" Content="📆" Click="BtnPickFromDate_Click" Width="32" Height="34" Background="#E2E8F0" Foreground="#1E293B" Margin="2,0,12,0"/>

                    <!-- تاریخ تا -->
                    <TextBlock Grid.Column="3" Text="تا تاریخ:" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="4" x:Name="TxtToDate" TextChanged="FilterInputs_Changed"/>
                    <Button Grid.Column="5" Content="📆" Click="BtnPickToDate_Click" Width="32" Height="34" Background="#E2E8F0" Foreground="#1E293B" Margin="2,0,12,0"/>

                    <!-- نوع مدرک -->
                    <TextBlock Grid.Column="6" Text="نوع مدرک:" FontWeight="Bold" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="7" x:Name="CmbDocType" SelectionChanged="FilterInputs_Changed" Margin="0,0,12,0"/>

                    <!-- جستجوی متن OCR -->
                    <TextBlock Grid.Column="8" Text="🔍 جستجوی متن OCR:" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="9" x:Name="TxtOcrSearch" TextChanged="FilterInputs_Changed" Margin="0,0,8,0"/>

                    <!-- دکمه بازنشانی کامل -->
                    <Button Grid.Column="10" Content="🔄 بازنشانی تمام فیلترها" Click="BtnResetAllFilters_Click" Width="150" Height="34" Background="#64748B"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ۴. جدول نتایج گزارش جامع -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
            <DataGrid x:Name="GridReportResults" AutoGenerateColumns="False" MouseDoubleClick="GridReportResults_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد بایگانی" Binding="{Binding CodBayegany}" Width="120" FontWeight="Bold"/>
                    <DataGridTextColumn Header="شماره مدرک" Binding="{Binding DocNumber}" Width="110"/>
                    <DataGridTextColumn Header="تاریخ سند" Binding="{Binding DocDate}" Width="100"/>
                    <DataGridTextColumn Header="نوع مدرک" Binding="{Binding DocType}" Width="110"/>
                    <DataGridTextColumn Header="موضوع اصلی" Binding="{Binding MainSubjectTitle}" Width="160"/>
                    <DataGridTextColumn Header="موضوع فرعی ۱" Binding="{Binding SubSubject1Title}" Width="150"/>
                    <DataGridTextColumn Header="موضوع فرعی ۲" Binding="{Binding SubSubject2Title}" Width="150"/>
                    <DataGridTextColumn Header="شخص اصلی مرتبط" Binding="{Binding MainPersonName}" Width="160" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="شخص فرعی ۱" Binding="{Binding SubPerson1Name}" Width="140"/>
                    <DataGridTextColumn Header="شخص فرعی ۲" Binding="{Binding SubPerson2Name}" Width="140"/>
                    <DataGridTextColumn Header="صفحات" Binding="{Binding PageCount}" Width="65"/>
                    <DataGridTextColumn Header="یادداشت‌ها و خلاصه" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ۵. نوار ابزار دکمه‌های صدور و چاپ -->
        <Border Grid.Row="4" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="🖨️ چاپ مستقیم و خروجی رسمی (Save as PDF)" Click="BtnPrintReport_Click" Width="290" Height="38" Background="#16A34A" FontWeight="Bold" FontSize="13.5" Margin="0,0,12,0"/>
                    <Button Content="📊 صدور خروجی اکسل (Excel / CSV)" Click="BtnExportExcel_Click" Width="240" Height="38" Background="#0284C7" FontWeight="Bold" FontSize="13.5"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="💡 راهنما: برای باز کردن و مشاهده اصل سند و تصاویر آن، روی هر ردیف دابل‌کلیک کنید." Foreground="#64748B" FontSize="12.5" HorizontalAlignment="Center"/>

                <Button Grid.Column="2" Content="بازگشت به پنجره اصلی" Click="BtnClose_Click" Width="150" Height="38" Background="#64748B"/>
            </Grid>
        </Border>
    </Grid>
</Window>
